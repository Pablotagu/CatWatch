FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["CatWatch.Log/CatWatch.Log.csproj", "CatWatch.Log/"]
COPY ["CatWatch.Contracts/CatWatch.Contracts.csproj", "CatWatch.Contracts/"]
RUN dotnet restore "CatWatch.Log/CatWatch.Log.csproj"
COPY . .
WORKDIR "/src/CatWatch.Log"
RUN dotnet publish -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "CatWatch.Log.dll"]
